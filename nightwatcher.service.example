[Unit]
Description=Log Watcher Telegram Bot
After=network.target

[Service]
ExecStart=/opt/nightwatch/nightwatche-rs
WorkingDirectory=/opt/nightwatch
EnvironmentFile=/opt/nightwatch/.env
User=logwatcher
Group=logwatcher
SupplementaryGroups=user
StandardOutput=append:/var/log/nightwatch/std.log
StandardError=append:/var/log/nightwatch/std.err
Restart=always
RestartSec=5
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
ReadWritePaths=/opt/nightwatch /var/log/nightwatch/std.log /var/log/nightwatch/std.err
ReadOnlyPaths=/var/log/auth.log /opt/nightwatch/.env

[Install]
WantedBy=multi-user.target
